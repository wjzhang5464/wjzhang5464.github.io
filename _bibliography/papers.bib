@inproceedings{zhang2024parametric,
  abbr={MMSP},
  bibtex_show={true},
  title={Parametric Modeling and Estimation of Photon Registrations for 3D Imaging},
  author={Zhang, Weijian and Weerasooriya, Hashan K. and Chennuri, Prateek and Chan, Stanley H.},
  booktitle={IEEE International Workshop on Multimedia Signal Processing (MMSP)},
  year={2024},
  abstract={In single-photon LiDAR systems, histogram distortion due to hardware dead time fundamentally limits the precision of depth estimation. We derive a parametric forward model of the photon-registration process under dead time and develop estimators that invert it, recovering depth accurately in flux regimes where conventional histogram-based methods break down.},
